# ═══════════════════════════════════════════
# RAZORPAY TRACKER — ENVIRONMENT VARIABLES
# NEVER commit this file to GitHub (.gitignore already excludes it).
# ═══════════════════════════════════════════

# ── Razorpay API keys ──────────────────────
# From Razorpay Dashboard -> Settings -> API Keys (use LIVE keys for real numbers).
# Paste the two values below (remove the < > brackets).
RAZORPAY_KEY_ID=<paste-your-rzp_live_key_id-here>
RAZORPAY_KEY_SECRET=<paste-your-razorpay-key-secret-here>

# ── Firebase Admin SDK ─────────────────────
# Easiest: copy these three values from your Railway proxy's env settings
# (FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY are already configured there).
# Or: Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key -> copy client_email and private_key from the JSON.
# FIREBASE_PRIVATE_KEY must stay inside quotes.
FIREBASE_PROJECT_ID=ican-242af
FIREBASE_CLIENT_EMAIL=<paste-client-email-here>
FIREBASE_PRIVATE_KEY="<paste-private-key-here>"
FIREBASE_DATABASE_URL=https://ican-242af-default-rtdb.firebaseio.com

# ── Server behaviour ───────────────────────
# How often the SERVER re-fetches data from Razorpay (milliseconds)
REFRESH_INTERVAL_MS=300000

# Port to run on (most hosts set this automatically)
PORT=3000
