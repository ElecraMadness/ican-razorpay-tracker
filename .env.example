# Copy this file to .env and fill in real values. NEVER commit .env to git.

# From Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Firebase Admin SDK credentials.
# Get them from Firebase Console -> Project Settings -> Service Accounts ->
# "Generate new private key", then paste the three values here.
# FIREBASE_PRIVATE_KEY must stay inside quotes (it contains newlines / \n).
FIREBASE_PROJECT_ID=ican-242af
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxxx@ican-242af.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://ican-242af-default-rtdb.firebaseio.com

# How often the SERVER re-fetches data from Razorpay (milliseconds)
REFRESH_INTERVAL_MS=300000

# Port to run on (most hosts set this automatically)
PORT=3000
